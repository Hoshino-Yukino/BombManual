---
import Manual from '../../layouts/Manual.astro';
import Keypad from '../../components/Keypad.astro';
import KeypadSolver from '../../components/KeypadSolver.astro';
import MorseSolver from '../../components/MorseSolver.astro';
import PasswordSolver from '../../components/PasswordSolver.astro';
import ComplicatedWiresSolver from '../../components/ComplicatedWiresSolver.astro';
import WireSequencesSolver from '../../components/WireSequencesSolver.astro';
import MazeSolver from '../../components/MazeSolver.astro';
import { MODULES, CHAPTER_LABELS } from '../../data/modules';

export function getStaticPaths() {
  return MODULES.map((m) => ({ params: { slug: m.slug }, props: { module: m } }));
}

const { module } = Astro.props;
const w = module.widget;
const isSolver = w === 'morse' || w === 'password' || w === 'complicated' || w === 'keypad' || w === 'sequences' || w === 'maze';
---
<Manual title={`${module.name} · 拆弹手册`} active={module.slug}>
  <article class="module">
    <div class="crumbs">{CHAPTER_LABELS[module.chapter]} · 第 {module.page} 页</div>
    <h1>{module.name}<span class="en">{module.nameEn}</span></h1>
    {module.flavor && <p class="flavor">{module.flavor}</p>}

    {isSolver ? (
      <Fragment>
        {w === 'morse' && <MorseSolver />}
        {w === 'password' && <PasswordSolver />}
        {w === 'complicated' && <ComplicatedWiresSolver />}
        {w === 'sequences' && <WireSequencesSolver />}
        {w === 'keypad' && <KeypadSolver />}
        {w === 'maze' && <MazeSolver />}
        <details class="manual-fold">
          <summary>📖 查看完整手册说明</summary>
          <div class="body" set:html={module.body} />
          {w === 'keypad' && <Keypad />}
          {w === 'maze' && <img class="maze-img" src="/assets/maze.png" alt="九张迷宫图" />}
        </details>
      </Fragment>
    ) : (
      <Fragment>
        <div class="body" set:html={module.body} />
        {w === 'keypad' && <Keypad />}
        {w === 'maze' && <img class="maze-img" src="/assets/maze.png" alt="九张迷宫图" />}
      </Fragment>
    )}
  </article>
</Manual>
