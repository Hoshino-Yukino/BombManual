---
import Manual from '../layouts/Manual.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { MODULES, CHAPTER_LABELS, type Chapter } from '../data/modules';

const chapters: Chapter[] = ['ch1', 'ch2', 'appendix'];
---
<Manual title="拆弹手册 · KTANE zh-CN" withNav={false}>
  <section class="hero">
    <h1>拆弹手册</h1>
    <p>《保持交流就没人爆炸》拆弹方式速查。选一个模块查看解除步骤；<b>摩斯电码</b>与<b>密码</b>模块带交互解算器，输入炸弹状态即得答案。</p>
  </section>

  {chapters.map((ch) => (
    <section>
      <h2 class="chapter-title">{CHAPTER_LABELS[ch]}</h2>
      <div class="cards">
        {MODULES.filter((m) => m.chapter === ch).map((m) => <ModuleCard module={m} />)}
      </div>
    </section>
  ))}
</Manual>
