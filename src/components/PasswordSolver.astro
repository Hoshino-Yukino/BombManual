---
// 5 个转轮，每位输入"能循环到的字母"。空 = 该位任意。
---
<div class="solver" id="pw-solver">
  <h3>🔑 密码解算器</h3>
  <label>每一位填入该转轮<b>能循环到的所有字母</b>（不区分大小写；留空表示任意）</label>
  <div class="pw-wheels">
    {[1, 2, 3, 4, 5].map((i) => (
      <div class="wheel">
        <label>第 {i} 位</label>
        <input type="text" data-pos={i - 1} placeholder="abc…" autocomplete="off" autocapitalize="off" spellcheck="false" />
      </div>
    ))}
  </div>
  <div class="btn-row"><button class="btn ghost" id="pw-clear">清空</button></div>
  <div class="pw-answer" id="pw-answer"></div>
</div>

<script>
  import { PASSWORD_WORDS } from '../data/password';

  const root = document.getElementById('pw-solver')!;
  const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-pos]'));
  const out = root.querySelector<HTMLElement>('#pw-answer')!;

  function solve() {
    const sets = inputs.map((el) => new Set(el.value.toLowerCase().replace(/[^a-z]/g, '').split('')));
    const matches = PASSWORD_WORDS.filter((w) =>
      w.split('').every((ch, i) => sets[i].size === 0 || sets[i].has(ch)),
    );
    if (matches.length === 1) {
      out.className = 'pw-answer';
      out.textContent = matches[0];
    } else if (matches.length === 0) {
      out.className = 'pw-answer multi';
      out.textContent = '无匹配单词，请检查输入。';
    } else {
      out.className = 'pw-answer multi';
      out.textContent = `${matches.length} 个候选：${matches.join('、')}（继续补充字母以缩小范围）`;
    }
  }

  inputs.forEach((el) => el.addEventListener('input', solve));
  root.querySelector('#pw-clear')!.addEventListener('click', () => {
    inputs.forEach((el) => (el.value = ''));
    out.textContent = '';
    out.className = 'pw-answer';
  });
  solve();
</script>
