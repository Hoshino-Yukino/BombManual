---
import type { Module } from '../data/modules';
interface Props { module: Module }
const { module } = Astro.props;
const interactive = ['morse', 'password', 'complicated', 'keypad'].includes(module.widget ?? '');
---
<a class="card" href={`/modules/${module.slug}`}>
  <span class="zh">{module.name}</span>
  <span class="en">{module.nameEn}</span>
  {interactive && <span class="tag">交互解算器</span>}
</a>
